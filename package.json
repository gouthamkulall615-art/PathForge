{
  "name": "path-forge-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --prefix client",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "client:lint": "npm run lint --prefix client",
    "server:dev": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client"
  }
}

